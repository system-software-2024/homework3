+++ b/kernel/sched/sched.h
@@ -168,6 +168,11 @@ static inline int fair_policy(int policy)
 	return policy == SCHED_NORMAL || policy == SCHED_BATCH;
 }
 
+static inline int mlq_policy(int policy)
+{
