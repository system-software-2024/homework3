diff --git a/kernel/sched/mlq.c b/kernel/sched/mlq.c
new file mode 100644
index 000000000000..fb355610ebf2
--- /dev/null
+++ b/kernel/sched/mlq.c
@@ -0,0 +1,381 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/kernel.h>
+#include "sched.h"
+
+#define MLQ_TIMESLICE_1_NS (50 * 1000000)
+#define MLQ_TIMESLICE_2_NS (100 * 1000000)
+
+#define MLQ_RUNTIME_NS 950000000
+#define MLQ_SLEEP_NS 50000000
+
+#define PRIO_TO_QUEUE(prio) ((prio)-1)
+
+#define pr_mlq(fmt, ...) printk(KERN_DEFAULT "MLQ: " fmt, ##__VA_ARGS__)
+
+static bool enable_throttling;
+
+static int __init mlq_throttling(char *str)
+{
+	enable_throttling = 1;
+	return 0;
+}
+
+early_param("mlq_throttling", mlq_throttling);
+
+static enum hrtimer_restart timer_callback(struct hrtimer *timer)
+{
+	struct rq *rq = container_of(timer, struct rq, mlq.throttle_timer);
+	struct mlq_rq *mlq_rq = &rq->mlq;
+
+	/* Ends throttling */
+	raw_spin_rq_lock(rq);
+	update_rq_clock(rq);
+	mlq_rq->is_throttled = false;
+	mlq_rq->exec_time = 0;
+	mlq_rq->sleep_time = 0;
+	mlq_rq->last_check_time = rq_clock_task(rq);
+	add_nr_running(rq, mlq_rq->nr_running);
+	resched_curr(rq);
+	raw_spin_rq_unlock(rq);
+
+	return HRTIMER_NORESTART;
+}
+
+static void check_and_start_throttling(struct rq *rq)
+{
+	s64 exptime = MLQ_SLEEP_NS - rq->mlq.sleep_time;
+
+	if (exptime < 0) {
+		/* Do not need throttling */
+		rq->mlq.exec_time = 0;
+		rq->mlq.sleep_time = 0;
+		return;
+	}
+
+	if (rq->mlq.is_throttled) {
+		/* Already throttled */
+		return;
+	}
+
+	pr_mlq("throttling for %llu ns\n", exptime);
+
+	hrtimer_start(&rq->mlq.throttle_timer, ns_to_ktime(exptime),
+		      HRTIMER_MODE_REL_HARD | HRTIMER_MODE_PINNED);
+	rq->mlq.is_throttled = true;
+	sub_nr_running(rq, rq->mlq.nr_running);
+	resched_curr(rq);
+}
+
+static void enqueue_task_mlq(struct rq *rq, struct task_struct *p, int flags)
+{
+	struct mlq_rq *mlq_rq = &rq->mlq;
+	int queue_idx = PRIO_TO_QUEUE(p->prio);
+
+	pr_mlq("enqueued task %d to queue %d\n", p->pid, queue_idx);
+	// // printk(__func__);
+	p->mlq.time_slice = PRIO_TO_QUEUE(p->prio) == 0 ? MLQ_TIMESLICE_1_NS :
+							  MLQ_TIMESLICE_2_NS;
+	list_add_tail(&p->mlq.run_list, &rq->mlq.queue[queue_idx]);
+	mlq_rq->nr_running++;
+	if (!rq->mlq.is_throttled)
+		add_nr_running(rq, 1);
+}
+
+static void dequeue_task_mlq(struct rq *rq, struct task_struct *p, int flags)
+{
+	struct mlq_rq *mlq_rq = &rq->mlq;
+
+	pr_mlq("dequeued task %d\n", p->pid);
+	// // printk(__func__);
+	list_del_init(&p->mlq.run_list);
+	mlq_rq->nr_running--;
+	if (!rq->mlq.is_throttled)
+		sub_nr_running(rq, 1);
+}
+
+static void requeue_task_mlq(struct rq *rq, struct task_struct *p)
+{
+	// // printk(__func__);
+	int queue_id = PRIO_TO_QUEUE(p->prio);
+
+	pr_mlq("requeued task %d to queue %d\n", p->pid, queue_id);
+	list_del_init(&p->mlq.run_list);
+	list_add_tail(&p->mlq.run_list, &rq->mlq.queue[PRIO_TO_QUEUE(p->prio)]);
+	p->mlq.time_slice = PRIO_TO_QUEUE(p->prio) == 0 ? MLQ_TIMESLICE_1_NS :
+							  MLQ_TIMESLICE_2_NS;
+
+}
+
+static void yield_task_mlq(struct rq *rq)
+{
+	// // printk(__func__);
+	requeue_task_mlq(rq, rq->curr);
+}
+
+static void check_preempt_curr_mlq(struct rq *rq, struct task_struct *p,
+				   int flags)
+{
+	// // printk(__func__);
+	if (p->prio < rq->curr->prio)
+		resched_curr(rq);
+}
+
+static struct task_struct *pick_task_mlq(struct rq *rq)
+{
+	struct task_struct *p;
+	struct sched_mlq_entity *se;
+	struct mlq_rq *mlq_rq = &rq->mlq;
+	int i;
+
+	if (rq->mlq.is_throttled)
+		return NULL;
+
+	for (i = 0; i < 3; i++) {
+		if (list_empty(&mlq_rq->queue[i]))
+			continue;
+
+		se = list_first_entry(&mlq_rq->queue[i],
+				      struct sched_mlq_entity, run_list);
+		p = container_of(se, struct task_struct, mlq);
+		pr_mlq("picked task %d from queue %d\n", p->pid, i);
+		return p;
+	}
+
+	// pr_mlq("No task to pick\n");
+	return NULL;
+}
+
+static void update_time_slice(struct task_struct *p)
+{
+	struct rq *rq = task_rq(p);
+	u64 now = rq_clock_task(rq);
+
+	p->mlq.time_slice -= rq_clock_task(rq) - p->mlq.exec_start;
+	p->mlq.exec_start = now;
+}
+
+static void update_curr_mlq(struct rq *rq)
+{
+	u64 delta_exec, now;
+	struct task_struct *curr = rq->curr;
+
+	if (curr->sched_class != &mlq_sched_class)
+		return;
+
+	update_time_slice(curr);
+
+	now = rq_clock_task(rq);
+	delta_exec = now - curr->se.exec_start;
+
+	schedstat_set(curr->se.statistics.exec_max,
+		      max(curr->se.statistics.exec_max, delta_exec));
+
+	curr->se.sum_exec_runtime += delta_exec;
+	account_group_exec_runtime(curr, delta_exec);
+
+	curr->se.exec_start = now;
+	cgroup_account_cputime(curr, delta_exec);
+
+	if (!rq->mlq.throttling_enabled)
+		return;
+
+	delta_exec = now - rq->mlq.last_check_time;
+	rq->mlq.exec_time += delta_exec;
+	rq->mlq.last_check_time = now;
+
+	if (rq->mlq.exec_time >= MLQ_RUNTIME_NS)
+		check_and_start_throttling(rq);
+}
+
+static void put_prev_task_mlq(struct rq *rq, struct task_struct *p)
+{
+	update_curr_mlq(rq);
+	rq->mlq.curr = NULL;
+}
+
+static inline void set_next_task_mlq(struct rq *rq, struct task_struct *p,
+				     bool first)
+{
+	u64 delta_exec, now;
+
+	rq->mlq.curr = p;
+	p->se.exec_start = rq_clock_task(rq);
+	p->mlq.exec_start = rq_clock_task(rq);
+
+	if (!rq->mlq.throttling_enabled)
+		return;
+
+	now = rq_clock_task(rq);
+	delta_exec = now - rq->mlq.last_check_time;
+	rq->mlq.sleep_time += delta_exec;
+	rq->mlq.last_check_time = now;
+
+	if (rq->mlq.sleep_time >= MLQ_SLEEP_NS) {
+		rq->mlq.sleep_time = 0;
+		rq->mlq.exec_time = 0;
+	}
+}
+
+static struct task_struct *pick_next_task_mlq(struct rq *rq)
+{
+	struct task_struct *p;
+
+	if (rq->mlq.curr)
+		put_prev_task_mlq(rq, rq->curr);
+	p = pick_task_mlq(rq);
+	if (p)
+		set_next_task_mlq(rq, p, false);
+	else if (current->sched_class == &mlq_sched_class)
+		pr_mlq("switched from MLQ\n");
+
+	return p;
+}
+
+static int balance_mlq(struct rq *rq, struct task_struct *prev,
+		       struct rq_flags *rf)
+{
+	return 0;
+}
+
+static int select_task_rq_mlq(struct task_struct *p, int task_cpu, int flags)
+{
+	struct rq *rq;
+	int cpus, best_cpu, min_nr_running;
+	cpumask_t cpumask = p->cpus_mask;
+
+	// printk(__func__);
+
+	if (!(flags & (WF_TTWU | WF_FORK)))
+		return task_cpu;
+
+	rcu_read_lock();
+	min_nr_running = -1;
+	for_each_cpu(cpus, &cpumask) {
+		rq = cpu_rq(cpus);
+		if (((min_nr_running == -1) ||
+		     (min_nr_running > rq->nr_running)) &&
+		    cpu_online(cpus)) {
+			min_nr_running = rq->nr_running;
+			best_cpu = cpus;
+		}
+	}
+	rcu_read_unlock();
+
+	if (min_nr_running == -1)
+		return task_cpu;
+
+	return best_cpu;
+}
+
+static void migrate_task_rq_mlq(struct task_struct *p, int new_cpu)
+{
+	// printk(__func__);
+}
+
+static void task_woken_mlq(struct rq *this_rq, struct task_struct *task)
+{
+	// printk(__func__);
+}
+
+static void rq_online_mlq(struct rq *rq)
+{
+	// printk(__func__);
+}
+
+static void rq_offline_mlq(struct rq *rq)
+{
+	// printk(__func__);
+}
+
+static void task_tick_mlq(struct rq *rq, struct task_struct *p, int queued)
+{
+	update_curr_mlq(rq);
+
+	if (PRIO_TO_QUEUE(p->prio) == 2)
+		return;
+
+	if (p->mlq.time_slice <= 0) {
+		pr_mlq("time slice expired for task %d\n", p->pid);
+		requeue_task_mlq(rq, p);
+		resched_curr(rq);
+	}
+}
+
+static void switched_from_mlq(struct rq *this_rq, struct task_struct *p)
+{
+	pr_mlq("task %d switched from MLQ\n", p->pid);
+}
+
+static void switched_to_mlq(struct rq *rq, struct task_struct *p)
+{
+	p->mlq.time_slice = 0;
+	pr_mlq("task %d switched to MLQ with priority %d\n", p->pid,
+	       p->prio);
+	if (task_on_rq_queued(p))
+		resched_curr(rq);
+}
+
+static void prio_changed_mlq(struct rq *rq, struct task_struct *p, int oldprio)
+{
+	pr_mlq("changed priority to %d for task %d\n", p->prio, p->pid);
+	if (task_on_rq_queued(p))
+		resched_curr(rq);
+}
+
+void init_mlq_rq(struct mlq_rq *mlq_rq)
+{
+	int i;
+
+	for (i = 0; i < 3; i++)
+		INIT_LIST_HEAD(&mlq_rq->queue[i]);
+	mlq_rq->nr_running = 0;
+
+	hrtimer_init(&mlq_rq->throttle_timer, CLOCK_MONOTONIC,
+		     HRTIMER_MODE_REL);
+	mlq_rq->throttle_timer.function = timer_callback;
+
+	mlq_rq->exec_time = 0;
+	mlq_rq->sleep_time = 0;
+	mlq_rq->last_check_time = 0;
+	mlq_rq->is_throttled = false;
+	mlq_rq->throttling_enabled = enable_throttling;
+}
+
+DEFINE_SCHED_CLASS(mlq) = {
+
+	.enqueue_task = enqueue_task_mlq,
+	.dequeue_task = dequeue_task_mlq,
+	.yield_task = yield_task_mlq,
+
+	.check_preempt_curr = check_preempt_curr_mlq,
+
+	.pick_next_task = pick_next_task_mlq,
+	.put_prev_task = put_prev_task_mlq,
+	.set_next_task = set_next_task_mlq,
+
+#ifdef CONFIG_SMP
+	.balance = balance_mlq,
+	.select_task_rq = select_task_rq_mlq,
+	.pick_task = pick_task_mlq,
+	.migrate_task_rq = migrate_task_rq_mlq,
+	.task_woken = task_woken_mlq,
+	.set_cpus_allowed = set_cpus_allowed_common,
+
+	.rq_online = rq_online_mlq,
+	.rq_offline = rq_offline_mlq,
+
+	.find_lock_rq = NULL,
+#endif
+
+	.task_tick = task_tick_mlq,
+	/*
+	 * The switched_from() call is allowed to drop rq->lock, therefore we
+	 * cannot assume the switched_from/switched_to pair is serialized by
+	 * rq->lock. They are however serialized by p->pi_lock.
+	 */
+	.switched_from = switched_from_mlq,
+	.switched_to = switched_to_mlq,
+
+	.prio_changed = prio_changed_mlq,
+	.update_curr = update_curr_mlq,
+};
