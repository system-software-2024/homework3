+		rt_policy(policy) || dl_policy(policy) || mlq_policy(policy);
 }
 
 static inline int task_has_idle_policy(struct task_struct *p)
@@ -188,6 +193,11 @@ static inline int task_has_idle_policy(struct task_struct *p)
 	return idle_policy(p->policy);
 }
 
+static inline int task_has_mlq_policy(struct task_struct *p)
+{
+	return mlq_policy(p->policy);
+}
+
 static inline int task_has_rt_policy(struct task_struct *p)
 {
 	return rt_policy(p->policy);
@@ -633,6 +643,20 @@ static inline int rt_bandwidth_enabled(void)
 # define HAVE_RT_PUSH_IPI
 #endif
 
+struct mlq_rq {
+	struct list_head	queue[3];
+	struct task_struct	*curr;
+	unsigned int		nr_running;
+
+	/* Following are used for throttling */
+	struct hrtimer		throttle_timer;
+	s64			exec_time;
+	s64			sleep_time;
+	s64			last_check_time;
+	bool			is_throttled;
+	bool			throttling_enabled;
+};
+
 /* Real-Time classes' related field in a runqueue: */
 struct rt_rq {
 	struct rt_prio_array	active;
@@ -956,6 +980,7 @@ struct rq {
 #endif
 
 	struct cfs_rq		cfs;
+	struct mlq_rq		mlq;
 	struct rt_rq		rt;
